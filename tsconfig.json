{
  "compilerOptions": {
      "target": "ES2022",
      "module": "NodeNext",
      "moduleResolution": "NodeNext",
      "strict": true,
      "esModuleInterop": true,
      "skipLibCheck": true,
      "outDir": "dist",
      "sourceMap": true,
      "types": ["node"],
      "verbatimModuleSyntax": true,
  },
  "include": ["src/**/*.ts"]
}